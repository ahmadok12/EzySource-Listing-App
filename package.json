{
  "name": "ezysource",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @ezysource/web --filter @ezysource/api dev",
    "dev:web": "pnpm --filter @ezysource/web dev",
    "dev:api": "pnpm --filter @ezysource/api dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm --filter @ezysource/web build && pnpm --filter @ezysource/api build",
    "db:migrate": "pnpm --filter @ezysource/db migrate",
    "db:bootstrap-owner": "pnpm --filter @ezysource/db bootstrap-owner"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
