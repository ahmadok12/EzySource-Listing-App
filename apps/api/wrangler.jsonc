{
  // One Worker serves the built web app and the /api routes on the same origin (specs/08).
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ezysource",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // postgres.js needs Node-compatible sockets and crypto in the Workers runtime.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Private media bucket; the API is its only reader (specs/08). Created in Milestone 0 step 4.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "ezysource-media" }],
  "vars": {
    "APP_ENV": "local",
    "APP_VERSION": "0.0.0"
  }
  // SUPABASE_URL is set per environment as a var; DATABASE_URL is a secret.
  // Secrets (database URL, AI keys) are set with `wrangler secret put`
  // or a local .dev.vars file. Names are listed in .dev.vars.example. Never commit values.
}
