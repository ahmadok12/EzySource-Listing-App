{
  // One Worker serves the built web app and the /api routes on the same origin (specs/08).
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ezysource",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // postgres.js needs Node-compatible sockets and crypto in the Workers runtime.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Private media bucket; the API is its only reader (specs/08).
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "ezysource-media" }],
  // Local development. Put DATABASE_URL and SUPABASE_URL in .dev.vars (see .dev.vars.example).
  "vars": {
    "APP_ENV": "local",
    "APP_VERSION": "0.0.0"
  },
  "env": {
    // Deployed by .github/workflows/deploy.yml. Bindings and vars are not inherited, so
    // they are repeated here. DATABASE_URL is a Worker secret set in the Cloudflare
    // dashboard, never committed. See docs/deploy.md.
    "staging": {
      "name": "ezysource-staging",
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "ezysource-media" }],
      "vars": {
        "APP_ENV": "staging",
        "APP_VERSION": "0.0.0",
        "SUPABASE_URL": "https://gmgyqrvwknmcditcaekl.supabase.co"
      }
    }
  }
}
