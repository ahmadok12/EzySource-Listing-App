# Copy to .env.local for local development.
# Only public, non-secret values may use the VITE_ prefix: they are bundled into the browser.
# Never put API keys, database URLs or service-role keys here (specs/12).

# Show unfinished member/admin screens in a production build (always shown in `pnpm dev`).
VITE_PREVIEW_SHELLS=false

# Supabase project URL and its publishable (anon) key. Leave empty to build without sign-in.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
